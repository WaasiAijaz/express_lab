<!DOCTYPE html>
<html lang="en">
<head>
    <title>Document</title>
    <style>
        .user{
            border-bottom: 2px solid black;
        }
    </style>
</head>
<body>
    <h1>Current Users</h1>
    <table>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Gender</th>
            <th>Age</th>
        </tr>
        <% users.forEach(user=>{ %>
            <tr>
                <td><%= user.firstName %></td>
                <td><%= user.lastName %></td>
                <td><%= user.gender %></td>
                <td><%= user.age %></td>
            </tr>

        <% }); %>
    </table>
</body>
</html>