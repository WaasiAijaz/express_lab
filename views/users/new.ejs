<!DOCTYPE html>
<html lang="en">
<head>
    <title>Document</title>
</head>
<body>
  <h1>Register User</h1>
  <form action="/users" method = "post">
     <fieldset>
      <legend>Name</legend>
      <label for="firstName">First Name</label>
      <input id="firstName" name="firstName" value="<%= firstName %>">
      <br>
      <label for="lastName">Last Name</label>
      <input id="lastName" name="lastName" value="<%= lastName %>">
    </fieldset>
    <br>
    <fieldset>
      <legend>Gender</legend>
      <input id="genderMale" type="radio" name="gender" value="Male">
      <label for="genderMale">Male</label>
      <input id="genderFemale" type="radio" name="gender" value="Female">
      <label for="genderFemale">Female</label>
    </fieldset>
    <br>
    <label for="age">Age</label>
    <input id="age" type="number" name="age">
    <br>
    <button type="submit">Submit</button>

  </form>  
</body>
</html>